<Project>
	<!--
		Central Package Management: every NuGet package version is set here, and PackageReferences
		in the projects omit Version. examples/ opts out (see examples/Directory.Packages.props).
	-->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup Label="Build">
		<PackageVersion Include="DarkPatterns.Build.Autoformat" Version="0.2.0" />
		<PackageVersion Include="DarkPatterns.Build.Structure" Version="0.1.0" />
	</ItemGroup>

	<ItemGroup Label="Libraries">
		<PackageVersion Include="Handlebars.Net" Version="2.1.6" />
		<PackageVersion Include="JsonPointer.Net" Version="3.0.3" />
		<PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageVersion Include="Microsoft.Extensions.CommandLineUtils" Version="1.1.1" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.1" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.FileProviders.Abstractions" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.FileProviders.Physical" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
		<PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
		<PackageVersion Include="System.Text.Json" Version="8.0.5" />
		<PackageVersion Include="Yaml2JsonNode" Version="2.1.0" />
		<PackageVersion Include="YamlDotNet" Version="15.1.2" />
		<!-- Tests use this version; analyzers pin an exact Roslyn version per build with VersionOverride (eng/roslyn.targets) -->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
	</ItemGroup>

	<ItemGroup Label="Tests">
		<PackageVersion Include="Bogus" Version="34.0.2" />
		<PackageVersion Include="coverlet.collector" Version="6.0.0" />
		<!-- Matches the ASP.NET Core version of each target framework -->
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" Condition=" '$(TargetFramework)' == 'net10.0' " />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" Condition=" '$(TargetFramework)' == 'net11.0' " />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
		<PackageVersion Include="Moq" Version="4.20.69" />
		<!-- UnionAttribute and IUnion below .NET 11, for jsonUnions -->
		<PackageVersion Include="PolySharp" Version="1.17.1" />
		<PackageVersion Include="Verify.Xunit" Version="31.12.5" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>
</Project>
