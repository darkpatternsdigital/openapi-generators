<Project>

	<ItemGroup>
        <_KnownRoslynVersions Include="4.8" />
        <_KnownRoslynVersions Include="5.12" />
	</ItemGroup>

    <PropertyGroup>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <!-- 4.8 ships with the .NET 8 SDK and VS 17.8; 5.12 with the .NET 11 SDK -->
        <RoslynApiVersion Condition=" '$(AnalyzerRoslynVersion)' == '5.12' ">5.12.0</RoslynApiVersion>
        <RoslynApiVersion Condition=" '$(AnalyzerRoslynVersion)' == '4.8' ">4.8.0</RoslynApiVersion>

        <DefineConstants Condition=" $([MSBuild]::VersionGreaterThanOrEquals($(RoslynApiVersion), 4.8.0)) ">$(DefineConstants);ROSLYN4_8_OR_GREATER</DefineConstants>
        <DefineConstants Condition=" $([MSBuild]::VersionGreaterThanOrEquals($(RoslynApiVersion), 5.12.0)) ">$(DefineConstants);ROSLYN5_12_OR_GREATER</DefineConstants>
    </PropertyGroup>

	<ItemGroup>
        <PackageReference Include="Microsoft.CSharp" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="[$(RoslynApiVersion)]" PrivateAssets="all">
			<IncludeAssets>compile</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>