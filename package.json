		"@darkpatternsdigital/prettier-config": "0.1.0",
    "@darkpatternsdigital/tsconfigs": "0.1.0",
    "@eslint/compat": "^1.1.1",
    "@types/node": "^22.4.1",
		"eslint": "^9.9.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "undici-types": "^6.19.6",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0"
  },
